{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/detail/:product/:variant", "destination": "/detail/:product" },
    { "source": "/event/:product/:variant", "destination": "/event/:product" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/song", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/film", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/ar/self", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/ar/friend", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/before-after", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/choose/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/find", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/find/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ]
}
